# =====================================================================
# DeTai16 - Cau hinh moi truong ( mau)
# Sao chep file nay thanh .env roi chinhh sua cho may cua ban.
# KHONG commit file .env vao Git.
# =====================================================================

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=detai16
DB_USER=detai16_user
DB_PASS=doi-mat-khau-o-day
DB_CHARSET=utf8mb4

# --- Ung dung ---
APP_NAME="DeTai16 - Luu trang Web de doc lai"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Session ---
SESSION_NAME=detai16_session
SESSION_LIFETIME=7200

# --- Quy tac cho phep lay noi dung (SSRF) ---
# Chi nhung dich trong danh sach nay moi duoc phep luu.
# Moi muc: ten_ten_mien|scheme|port|cach_dung_bo_sung
#  * = moi ten_mien con (chi dung o muc "domain")
# Cach dung bo sung dung cho muc "host": "loopback" | "private" | "all"
ALLOWED_FETCH_TARGETS=127.0.0.1:8080|host:127.0.0.1|scheme:http,https|port:8080|cidrs:127.0.0.0/8

# Cho phep truy cap mang rieng / loopback khi dung may chu thu nghiem.
# Neu tat, chi cho phep dia chi cong khai.
ALLOW_PRIVATE_NETWORK=true

# --- Gioi han lay noi dung ---
FETCH_CONNECT_TIMEOUT=5
FETCH_TOTAL_TIMEOUT=15
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=5
FETCH_USER_AGENT=DeTai16ArchiveBot/1.0 (+https://github.com/your-group/detai16)

# --- Gioi han luu anh ---
IMAGE_MAX_BYTES=2097152
IMAGE_ALLOWED_MIME=image/png,image/jpeg,image/webp

# --- Thu muc luu tru noi dung (nam ngoaii web root) ---
STORAGE_PATH=storage
WEB_PUBLIC_PATH=public