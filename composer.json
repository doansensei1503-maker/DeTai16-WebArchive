{
    "name": "detai16/web-archive-reader",
    "description": "DeTai16 - Ung dung luu noi dung trang Web de doc lai va tim kiem (Chuc nang 1-3)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-fileinfo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/console.php migrate",
        "seed": "php bin/console.php seed",
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php"
    },
    "config": {
        "sort-packages": true
    }
}